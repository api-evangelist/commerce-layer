{
  "opencollection": "1.0.0",
  "info": {
    "name": "Commerce Layer addresses user API",
    "version": "7.10.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "user",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve an user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{your_organization_slug}.commercelayer.io/api/user"
          },
          "docs": "Retrieve an user"
        },
        {
          "info": {
            "name": "Updates an user",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{your_organization_slug}.commercelayer.io/api/user",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an user"
        }
      ]
    }
  ],
  "bundled": true
}