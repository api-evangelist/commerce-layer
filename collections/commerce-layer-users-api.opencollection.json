{
  "opencollection": "1.0.0",
  "info": {
    "name": "Commerce Layer addresses users API",
    "version": "7.10.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Related identity provider",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{your_organization_slug}.commercelayer.io/api/identity_providers/:identityProviderId/user",
            "params": [
              {
                "name": "identityProviderId",
                "value": "",
                "type": "path",
                "description": "The ID of the resource."
              }
            ]
          },
          "docs": "Related identity provider"
        }
      ]
    }
  ],
  "bundled": true
}