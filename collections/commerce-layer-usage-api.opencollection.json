{
  "opencollection": "1.0.0",
  "info": {
    "name": "Commerce Layer addresses usage API",
    "version": "7.10.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "usage",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Query date_breakdown on usage",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{your_organization_slug}.commercelayer.io/api/usage/date_breakdown",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Get date_breakdown results from usage"
        },
        {
          "info": {
            "name": "Query search on usage",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{your_organization_slug}.commercelayer.io/api/usage/search",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Get search results from usage"
        }
      ]
    }
  ],
  "bundled": true
}