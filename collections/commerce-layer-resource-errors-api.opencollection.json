{
  "opencollection": "1.0.0",
  "info": {
    "name": "Commerce Layer addresses resource_errors API",
    "version": "7.10.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "resource_errors",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve the resource errors associated to the order",
            "type": "http"
