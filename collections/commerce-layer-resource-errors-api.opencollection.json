          "docs": "List all resource errors"
        },
        {
          "info": {
            "name": "Retrieve a resource error",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{your_organization_slug}.commercelayer.io/api/resource_errors/:resourceErrorId",
            "params": [
              {
                "name": "resourceErrorId",
                "value": "",
                "type": "path",
                "description": "The resource's id"
              }
            ]
          },
          "docs": "Retrieve a resource error"
        },
        {
          "info": {
            "name": "Retrieve the resource errors associated to the return",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{your_organization_slug}.commercelayer.io/api/returns/:returnId/resource_errors",
            "params": [
              {
                "name": "returnId",
                "value": "",
                "type": "path",
                "description": "The resource's id"
              }
            ]
          },
          "docs": "Retrieve the resource errors associated to the return"
        }
      ]
    }
  ],
  "bundled": true
}