            "url": "https://{your_organization_slug}.commercelayer.io/api/orders/:orderId/resource_errors",
            "params": [
              {
                "name": "orderId",
                "value": "",
                "type": "path",
                "description": "The resource's id"
              }
            ]
          },
          "docs": "Retrieve the resource errors associated to the order"
        },
        {
          "info": {
            "name": "List all resource errors",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{your_organization_slug}.commercelayer.io/api/resource_errors"
