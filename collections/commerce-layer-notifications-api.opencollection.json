{
  "opencollection": "1.0.0",
  "info": {
    "name": "Commerce Layer addresses notifications API",
    "version": "7.10.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "notifications",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve the notifications associated to the line item",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{your_organization_slug}.commercelayer.io/api/line_items/:lineItemId/notifications",
            "params": [
              {
                "name": "lineItemId",
                "value": "",
                "type": "path",
                "description": "The resource's id"
              }
            ]
          },
          "docs": "Retrieve the notifications associated to the line item"
        },
        {
          "info": {
            "name": "List all notifications",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{your_organization_slug}.commercelayer.io/api/notifications"
          },
          "docs": "List all notifications"
        },
        {
          "info": {
            "name": "Create a notification",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{your_organization_slug}.commercelayer.io/api/notifications",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a notification"
        },
        {
          "info": {
            "name": "Retrieve a notification",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{your_organization_slug}.commercelayer.io/api/notifications/:notificationId",
