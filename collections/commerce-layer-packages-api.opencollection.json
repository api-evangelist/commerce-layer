{
  "opencollection": "1.0.0",
  "info": {
    "name": "Commerce Layer addresses packages API",
    "version": "7.10.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "packages",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all packages",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{your_organization_slug}.commercelayer.io/api/packages"
          },
          "docs": "List all packages"
        },
        {
          "info": {
            "name": "Create a package",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{your_organization_slug}.commercelayer.io/api/packages",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a package"
        },
        {
          "info": {
            "name": "Retrieve a package",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{your_organization_slug}.commercelayer.io/api/packages/:packageId",
            "params": [
              {
                "name": "packageId",
                "value": "",
                "type": "path",
                "description": "The resource's id"
              }
            ]
          },
          "docs": "Retrieve a package"
        },
        {
          "info": {
            "name": "Update a package",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{your_organization_slug}.commercelayer.io/api/packages/:packageId",
            "params": [
              {
                "name": "packageId",
                "value": "",
                "type": "path",
                "description": "The resource's id"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a package"
        },
        {
          "info": {
            "name": "Delete a package",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{your_organization_slug}.commercelayer.io/api/packages/:packageId",
            "params": [
              {
                "name": "packageId",
                "value": "",
                "type": "path",
                "description": "The resource's id"
              }
            ]
          },
          "docs": "Delete a package"
        },
        {
          "info": {
            "name": "Retrieve the package associated to the parcel",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{your_organization_slug}.commercelayer.io/api/parcels/:parcelId/package",
            "params": [
              {
                "name": "parcelId",
                "value": "",
                "type": "path",
                "description": "The resource's id"
              }
            ]
          },
          "docs": "Retrieve the package associated to the parcel"
        }
      ]
    }
  ],
  "bundled": true
}