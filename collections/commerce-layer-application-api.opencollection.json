{
  "opencollection": "1.0.0",
  "info": {
    "name": "Commerce Layer addresses application API",
    "version": "7.10.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "application",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve the application",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{your_organization_slug}.commercelayer.io/api/application"
          },
          "docs": "Retrieve the application"
        }
      ]
    }
  ],
  "bundled": true
}